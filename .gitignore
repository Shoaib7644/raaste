# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and private credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# secrets / API keys / passwords / tokens / private credentials
*.pem
*.key
*.p8
*.p12
*.crt
*.cer
*.der
*.secret
*secret*
*secrets*
*credential*
*credentials*
*token*
*tokens*
*password*
*passwords*
secrets/
credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor and Codex artifacts
.idea/
.codex/
dev.log
